# Normalize line endings: LF everywhere on checkout and commit.
* text=auto eol=lf

# Force LF for scripts and sources (they run on Linux containers/CI).
*.sh text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Never touch these.
*.png binary
*.jpg binary
*.ico binary
*.wasm binary
*.woff binary
*.woff2 binary
