{
  "name": "9router-app",
  "version": "0.5.112",
  "description": "9Router web dashboard",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "next dev --port 20127",
    "dev:webpack": "next dev --webpack --port 20127",
    "build": "next build --webpack",
    "postbuild": "node scripts/copy-standalone-assets.mjs",
    "postbuild:bun": "node scripts/copy-standalone-assets.mjs",
    "start": "node custom-server.js --port 20127",
    "dev:bun": "bun --bun next dev --webpack --port 20127",
    "build:bun": "bun --bun next build --webpack",
    "start:bun": "bun ./.next/standalone/custom-server.js",
    "cli:pack": "pnpm -C cli run pack:cli",
    "cli:publish": "pnpm -C cli run publish:cli"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@next/third-parties": "^16.3.6",
    "@node-saml/node-saml": "^5.1.0",
    "@xyflow/react": "^12.12.0",
    "bcryptjs": "^3.0.3",
    "chalk": "^6.0.0",
    "confbox": "^0.2.4",
    "enquirer": "^2.4.1",
    "jose": "^6.2.12",
    "marked": "^18.0.14",
    "material-symbols": "^0.44.12",
    "monaco-editor": "^0.57.0",
    "next": "^16.4.2",
    "node-forge": "^1.4.0",
    "node-machine-id": "^1.1.12",
    "open": "^11.0.4",
    "ora": "^9.4.1",
    "prop-types": "^15.8.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "socks-proxy-agent": "^10.1.0",
    "sql.js": "^1.14.2",
    "undici": "^8.11.2",
    "uuid": "^14.0.2",
    "zustand": "^5.0.15"
  },
  "optionalDependencies": {
    "@aws-sdk/credential-providers": "^3.1135.0",
    "ajv": "^8.17.1",
    "better-sqlite3": "^12.11.1",
    "ws": "^8.18.0"
  },
  "comment_better_sqlite3": "kept in optionalDependencies so npm install doesn't fail on systems without build tools — sql.js is used as fallback at runtime",
  "comment_aws_sdk_credential_providers": "kept in optionalDependencies (npm still installs these by default) and imported lazily in shared/awsCredentials.js — only AWS Bedrock connections using profile/SSO mode need it; static accessKeyId/secretAccessKey connections never load it",
  "comment_playwright_core": "devDependency only (keeps end-user installs small); open-sse/services/lazyRuntime.js downloads it + wreq-js on first use into <DATA_DIR>/runtime. playwright-core ships no browser binaries (run `npx playwright-core install chromium` or point OBSCURA_CDP_ENDPOINT/cloakbrowser at a stealth engine)",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "playwright-core": "^1.62.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "wreq-js": "^3.2.0"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "ip-address": "^10.7.4"
  }
}
