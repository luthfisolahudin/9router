# VCS
.git
**/.git

# Editor
.vscode
**/.vscode
.idea

# Dependencies and build output
node_modules
**/node_modules
.next
.next-cli-build
out
build
dist
coverage

# Runtime data and logs
data
logs

# Local env files (inject at runtime via --env-file or -e)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Fork/agent tooling and docs — never needed inside the image, and keeping them
# out stops doc/workflow changes from busting the COPY . . cache layer.
.github
.agents
.zcode
.claude
.cursor
docs
gitbook
scripts/fork
*.md
.gitattributes
.dockerignore

# Tests (workspace install needs only the manifest)
tests/*
!tests/package.json

# pnpm
.pnpm-store
